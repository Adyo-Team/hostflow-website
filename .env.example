# Supabase remains the backend (Auth, PostgreSQL and private Storage).
# Server-only configuration: no NEXT_PUBLIC_* or service_role/secret key.
# Required in Railway staging and available at runtime; not needed to compile.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Exact public HTTPS origin, without path or trailing slash.
# Example format: https://<staging-domain>.up.railway.app
# Local development: http://localhost:3000
APP_URL=

# Railway service configuration (set in Railway, leave commented locally).
# NODE_ENV=production
# RAILPACK_NODE_VERSION=24
# Railpack installs build/test dependencies and honors the frozen lockfile.
# RAILPACK_INSTALL_CMD=pnpm install --frozen-lockfile
# PORT is injected by Railway; pnpm start reads it and binds to 0.0.0.0.
# For a local production test: PORT=3000
